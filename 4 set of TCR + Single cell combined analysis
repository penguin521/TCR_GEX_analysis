clonotype_signatures <- pmap_dfr(
  set_dirs,
  function(set_id, gex_sample, tcr_sample, outdir) {
    
    contigs <- read_csv(
      file.path(outdir, "07_productive_tcr_contigs.csv"),
      show_col_types = FALSE
    ) %>%
      clean_names()
    
    clonos <- read_csv(
      file.path(outdir, "02_all_clonotypes_ranked_with_bins.csv"),
      show_col_types = FALSE
    ) %>%
      clean_names()
    
    contigs %>%
      filter(
        chain %in% c("TRA", "TRB"),
        !is.na(raw_clonotype_id),
        !is.na(cdr3)
      ) %>%
      left_join(
        clonos %>%
          select(clonotype_id, clonotype_rank, frequency, percent, frequency_bin),
        by = c("raw_clonotype_id" = "clonotype_id")
      ) %>%
      group_by(raw_clonotype_id, clonotype_rank, frequency, percent, frequency_bin) %>%
      summarise(
        tra_cdr3s = paste(sort(unique(cdr3[chain == "TRA"])), collapse = "; "),
        trb_cdr3s = paste(sort(unique(cdr3[chain == "TRB"])), collapse = "; "),
        
        cdr3_signature = paste(
          sort(unique(paste(chain, cdr3, sep = ":"))),
          collapse = "|"
        ),
        
        vj_cdr3_signature = paste(
          sort(unique(paste(chain, v_gene, j_gene, cdr3, sep = ":"))),
          collapse = "|"
        ),
        
        n_cells_with_clonotype = n_distinct(barcode),
        .groups = "drop"
      ) %>%
      mutate(
        set_id = set_id,
        gex_sample = gex_sample,
        tcr_sample = tcr_sample,
        sample_clonotype_id = paste(tcr_sample, raw_clonotype_id, sep = ": "),
        .before = 1
      )
  }
)

