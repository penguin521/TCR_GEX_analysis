# ---- Utility functions ----

extract_10x_barcode <- function(x) {
  stringr::str_extract(x, "[ACGT]{16}-[0-9]+")
}

find_one_file <- function(folder, pattern, label) {
  hits <- list.files(
    folder,
    pattern = pattern,
    full.names = TRUE,
    ignore.case = TRUE
  )
  
  if (length(hits) == 0) {
    stop("Could not find ", label, " in: ", folder)
  }
  
  hits[1]
}

read_gex_counts <- function(gex_dir) {
  h5_file <- file.path(gex_dir, "filtered_feature_bc_matrix.h5")
  matrix_dir <- file.path(gex_dir, "filtered_feature_bc_matrix")
  
  if (file.exists(h5_file)) {
    gex_counts <- Read10X_h5(h5_file)
  } else if (dir.exists(matrix_dir)) {
    gex_counts <- Read10X(matrix_dir)
  } else {
    stop("Could not find filtered_feature_bc_matrix.h5 or filtered_feature_bc_matrix in: ", gex_dir)
  }
  
  if (is.list(gex_counts)) {
    if ("Gene Expression" %in% names(gex_counts)) {
      gex_counts <- gex_counts[["Gene Expression"]]
    } else {
      gex_counts <- gex_counts[[1]]
    }
  }
  
  return(gex_counts)
}

save_plot <- function(plot_obj, filename, width = 8, height = 6) {
  ggsave(filename, plot_obj, width = width, height = height, dpi = 300)
}

# ---- Analyze one paired GEX/TCR set ----

run_one_set <- function(set_row, cluster_label_vector) {
  
  set_id <- set_row$set_id
  gex_sample <- set_row$gex_sample
  tcr_sample <- set_row$tcr_sample
  gex_dir <- set_row$gex_dir
  tcr_dir <- set_row$tcr_dir
  outdir <- set_row$analysis_dir
  
  message("====================================================")
  message("Running ", set_id, ": ", gex_sample, " GEX -> ", tcr_sample, " TCR")
  message("====================================================")
  
  dir.create(outdir, showWarnings = FALSE, recursive = TRUE)
  
  # Load the TCR output files
  
  metrics_file <- list.files(
    tcr_dir,
    pattern = "^metrics_summary.*\\.csv$",
    full.names = TRUE,
    ignore.case = TRUE
  )
  
  clonotypes_file <- find_one_file(
    tcr_dir,
    "^clonotypes.*\\.csv$",
    "clonotypes.csv"
  )
  
  contig_file <- find_one_file(
    tcr_dir,
    "^filtered_contig_annotations.*\\.csv$",
    "filtered_contig_annotations.csv"
  )
  
  if (length(metrics_file) > 0) {
    metrics <- read_csv(metrics_file[1], show_col_types = FALSE)
    write_csv(metrics, file.path(outdir, "01_metrics_summary_copy.csv"))
  }
  
  clonos <- read_csv(clonotypes_file, show_col_types = FALSE) %>%
    clean_names()
  
  contig <- read_csv(contig_file, show_col_types = FALSE) %>%
    clean_names()
  
  # Summarize clonotype abundance and diversity
  
  clonos2 <- clonos %>%
    mutate(
      frequency = as.numeric(frequency)
    ) %>%
    arrange(desc(frequency)) %>%
    mutate(
      clonotype_rank = row_number(),
      percent = if ("proportion" %in% names(.)) {
        as.numeric(proportion) * 100
      } else {
        frequency / sum(frequency, na.rm = TRUE) * 100
      },
      frequency_bin = case_when(
        percent >= 1 ~ "Dominant >=1%",
        percent >= 0.2 ~ "Expanded 0.2-1%",
        percent >= 0.1 ~ "Low-frequency 0.1-0.2%",
        TRUE ~ "Rare tail <0.1%"
      )
    )
  
  write_csv(clonos2, file.path(outdir, "02_all_clonotypes_ranked_with_bins.csv"))
  
  diversity_summary <- tibble(
    set_id = set_id,
    gex_sample = gex_sample,
    tcr_sample = tcr_sample,
    total_clonotypes = nrow(clonos2),
    total_tcr_barcodes = sum(clonos2$frequency, na.rm = TRUE),
    top_1_percent = sum(clonos2$percent[1:min(1, nrow(clonos2))], na.rm = TRUE),
    top_5_percent = sum(clonos2$percent[1:min(5, nrow(clonos2))], na.rm = TRUE),
    top_10_percent = sum(clonos2$percent[1:min(10, nrow(clonos2))], na.rm = TRUE),
    top_20_percent = sum(clonos2$percent[1:min(20, nrow(clonos2))], na.rm = TRUE),
    top_50_percent = sum(clonos2$percent[1:min(50, nrow(clonos2))], na.rm = TRUE),
    shannon_diversity = diversity(clonos2$frequency, index = "shannon"),
    simpson_diversity = diversity(clonos2$frequency, index = "simpson")
  )
  
  write_csv(diversity_summary, file.path(outdir, "03_tcr_diversity_summary.csv"))
  
  bin_summary <- clonos2 %>%
    group_by(frequency_bin) %>%
    summarise(
      clonotype_count = n(),
      barcode_count = sum(frequency, na.rm = TRUE),
      percent_of_tcr_barcodes = sum(percent, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    mutate(
      set_id = set_id,
      gex_sample = gex_sample,
      tcr_sample = tcr_sample
    ) %>%
    arrange(desc(percent_of_tcr_barcodes))
  
  write_csv(bin_summary, file.path(outdir, "04_clonotype_frequency_bin_summary.csv"))
  
  p_bin <- bin_summary %>%
    ggplot(aes(x = frequency_bin, y = percent_of_tcr_barcodes)) +
    geom_col() +
    coord_flip() +
    labs(
      title = paste0(tcr_sample, " TCR Clonotype Frequency Bins"),
      x = "Frequency bin",
      y = "Percent of TCR barcodes"
    ) +
    theme_classic()
  
  save_plot(p_bin, file.path(outdir, "04_clonotype_frequency_bin_summary.png"), 8, 5)
  
  p_top20 <- clonos2 %>%
    slice_head(n = 20) %>%
    ggplot(aes(x = fct_reorder(clonotype_id, percent), y = percent)) +
    geom_col() +
    coord_flip() +
    labs(
      title = paste0(tcr_sample, " Top 20 TCR Clonotypes"),
      x = "Clonotype",
      y = "Percent of TCR barcodes"
    ) +
    theme_classic()
  
  save_plot(p_top20, file.path(outdir, "05_top_20_clonotypes.png"), 8, 6)
  
  p_cumulative <- clonos2 %>%
    mutate(cumulative_percent = cumsum(percent)) %>%
    ggplot(aes(x = clonotype_rank, y = cumulative_percent)) +
    geom_line() +
    labs(
      title = paste0(tcr_sample, " Cumulative Clonotype Contribution"),
      x = "Clonotype rank",
      y = "Cumulative percent of TCR barcodes"
    ) +
    theme_classic()
  
  save_plot(p_cumulative, file.path(outdir, "06_cumulative_clonotype_contribution.png"), 8, 5)
  
  # Summarize productive contigs and receptor features
  
  contig_prod <- contig %>%
    filter(as.character(productive) %in% c("TRUE", "True", "true", "T"))
  
  write_csv(contig_prod, file.path(outdir, "07_productive_tcr_contigs.csv"))
  
  chain_summary <- contig_prod %>%
    count(chain, sort = TRUE)
  
  write_csv(chain_summary, file.path(outdir, "08_productive_chain_summary.csv"))
  
  p_chain <- chain_summary %>%
    ggplot(aes(x = chain, y = n)) +
    geom_col() +
    labs(
      title = paste0(tcr_sample, " Productive TCR Chain Counts"),
      x = "TCR chain",
      y = "Productive contig count"
    ) +
    theme_classic()
  
  save_plot(p_chain, file.path(outdir, "08_productive_chain_counts.png"), 6, 5)
  
  paired_summary <- contig_prod %>%
    filter(chain %in% c("TRA", "TRB")) %>%
    distinct(barcode, chain) %>%
    group_by(barcode) %>%
    summarise(
      has_TRA = any(chain == "TRA"),
      has_TRB = any(chain == "TRB"),
      chain_status = case_when(
        has_TRA & has_TRB ~ "Paired TRA+TRB",
        has_TRA & !has_TRB ~ "TRA only",
        !has_TRA & has_TRB ~ "TRB only",
        TRUE ~ "Other"
      ),
      .groups = "drop"
    )
  
  paired_counts <- paired_summary %>%
    count(chain_status) %>%
    mutate(percent = n / sum(n) * 100)
  
  write_csv(paired_counts, file.path(outdir, "09_paired_TRA_TRB_summary.csv"))
  
  p_paired <- paired_counts %>%
    ggplot(aes(x = chain_status, y = percent)) +
    geom_col() +
    coord_flip() +
    labs(
      title = paste0(tcr_sample, " Paired TRA/TRB Recovery"),
      x = "TCR recovery status",
      y = "Percent of TCR-positive cells"
    ) +
    theme_classic()
  
  save_plot(p_paired, file.path(outdir, "09_paired_TRA_TRB_recovery.png"), 7, 5)
  
  v_gene_summary <- contig_prod %>%
    filter(chain %in% c("TRA", "TRB"), !is.na(v_gene)) %>%
    count(chain, v_gene, sort = TRUE)
  
  write_csv(v_gene_summary, file.path(outdir, "10_v_gene_usage_summary.csv"))
  
  p_vgene <- v_gene_summary %>%
    group_by(chain) %>%
    slice_max(n, n = 20, with_ties = FALSE) %>%
    ungroup() %>%
    ggplot(aes(x = fct_reorder(v_gene, n), y = n)) +
    geom_col() +
    coord_flip() +
    facet_wrap(~chain, scales = "free_y") +
    labs(
      title = paste0(tcr_sample, " Top TCR V Gene Usage"),
      x = "V gene",
      y = "Productive contig count"
    ) +
    theme_classic()
  
  save_plot(p_vgene, file.path(outdir, "10_top_v_gene_usage.png"), 10, 6)
  
  j_gene_summary <- contig_prod %>%
    filter(chain %in% c("TRA", "TRB"), !is.na(j_gene)) %>%
    count(chain, j_gene, sort = TRUE)
  
  write_csv(j_gene_summary, file.path(outdir, "11_j_gene_usage_summary.csv"))
  
  p_jgene <- j_gene_summary %>%
    group_by(chain) %>%
    slice_max(n, n = 20, with_ties = FALSE) %>%
    ungroup() %>%
    ggplot(aes(x = fct_reorder(j_gene, n), y = n)) +
    geom_col() +
    coord_flip() +
    facet_wrap(~chain, scales = "free_y") +
    labs(
      title = paste0(tcr_sample, " Top TCR J Gene Usage"),
      x = "J gene",
      y = "Productive contig count"
    ) +
    theme_classic()
  
  save_plot(p_jgene, file.path(outdir, "11_top_j_gene_usage.png"), 10, 6)
  
  cdr3_lengths <- contig_prod %>%
    filter(chain %in% c("TRA", "TRB"), !is.na(cdr3)) %>%
    mutate(cdr3_length = nchar(cdr3))
  
  write_csv(cdr3_lengths, file.path(outdir, "12_cdr3_lengths_by_contig.csv"))
  
  p_cdr3 <- cdr3_lengths %>%
    ggplot(aes(x = cdr3_length)) +
    geom_histogram(binwidth = 1) +
    facet_wrap(~chain) +
    labs(
      title = paste0(tcr_sample, " CDR3 Amino Acid Length Distribution"),
      x = "CDR3 amino acid length",
      y = "Productive contig count"
    ) +
    theme_classic()
  
  save_plot(p_cdr3, file.path(outdir, "12_cdr3_length_distribution.png"), 8, 5)
  
  expanded <- clonos2 %>% filter(percent >= 0.2)
  low_frequency <- clonos2 %>% filter(percent >= 0.1, percent < 0.2)
  rare_tail <- clonos2 %>% filter(percent < 0.1)
  
  write_csv(expanded, file.path(outdir, "13_expanded_clonotypes_percent_ge_0.2.csv"))
  write_csv(low_frequency, file.path(outdir, "14_low_frequency_clonotypes_0.1_to_0.2.csv"))
  write_csv(rare_tail, file.path(outdir, "15_rare_tail_clonotypes_lt_0.1.csv"))
  
  expanded_contig_details <- contig_prod %>%
    filter(raw_clonotype_id %in% expanded$clonotype_id) %>%
    left_join(
      clonos2 %>%
        select(clonotype_id, frequency, percent, frequency_bin),
      by = c("raw_clonotype_id" = "clonotype_id")
    ) %>%
    select(any_of(c(
      "raw_clonotype_id", "frequency", "percent", "frequency_bin",
      "barcode", "chain", "v_gene", "j_gene", "c_gene",
      "cdr3", "cdr3_nt", "reads", "umis"
    ))) %>%
    arrange(desc(percent), raw_clonotype_id, barcode, chain)
  
  write_csv(
    expanded_contig_details,
    file.path(outdir, "16_expanded_clonotype_CDR3_VJ_details.csv")
  )
  
  expanded_clonotype_summary <- expanded_contig_details %>%
    group_by(raw_clonotype_id, frequency, percent, frequency_bin) %>%
    summarise(
      chains_detected = paste(sort(unique(chain)), collapse = "; "),
      v_genes = paste(sort(unique(na.omit(v_gene))), collapse = "; "),
      j_genes = paste(sort(unique(na.omit(j_gene))), collapse = "; "),
      cdr3s = paste(sort(unique(na.omit(cdr3))), collapse = "; "),
      number_of_cells = n_distinct(barcode),
      .groups = "drop"
    ) %>%
    arrange(desc(percent))
  
  write_csv(
    expanded_clonotype_summary,
    file.path(outdir, "17_expanded_clonotype_summary_collapsed.csv")
  )
  
  # Build and process the matching gene-expression dataset
  
  gex_counts <- read_gex_counts(gex_dir)
  
  seurat_obj <- CreateSeuratObject(
    counts = gex_counts,
    project = gex_sample,
    min.cells = 3,
    min.features = 200
  )
  
  mt_pattern <- if (any(grepl("^mt-", rownames(seurat_obj)))) "^mt-" else "^MT-"
  
  seurat_obj[["percent.mt"]] <- PercentageFeatureSet(seurat_obj, pattern = mt_pattern)
  
  p_qc <- VlnPlot(
    seurat_obj,
    features = c("nFeature_RNA", "nCount_RNA", "percent.mt"),
    ncol = 3
  ) +
    ggtitle(paste0(gex_sample, " QC Before Filtering"))
  
  save_plot(p_qc, file.path(outdir, "18_QC_violin_before_filtering.png"), 10, 5)
  
  seurat_obj <- subset(
    seurat_obj,
    subset = nFeature_RNA > 200 &
      nFeature_RNA < 6000 &
      percent.mt < 15
