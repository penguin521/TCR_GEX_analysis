    )
  
  write_csv(top_markers_compact, file.path(outdir, "24_top_markers_compact.csv"))
  
  # Match TCR and GEX barcodes, then add TCR metadata to Seurat
  
  tcr_barcodes <- unique(contig_prod$barcode)
  rna_barcodes <- colnames(seurat_obj)
  
  direct_overlap <- sum(tcr_barcodes %in% rna_barcodes)
  
  tcr_clean <- tibble(
    tcr_barcode_original = tcr_barcodes,
    barcode_core = extract_10x_barcode(tcr_barcodes)
  )
  
  rna_clean <- tibble(
    seurat_cell = rna_barcodes,
    barcode_core = extract_10x_barcode(rna_barcodes)
  )
  
  barcode_overlap <- inner_join(rna_clean, tcr_clean, by = "barcode_core")
  
  overlap_summary <- tibble(
    set_id = set_id,
    gex_sample = gex_sample,
    tcr_sample = tcr_sample,
    unique_tcr_barcodes = length(unique(tcr_barcodes)),
    seurat_cells_after_qc = ncol(seurat_obj),
    direct_overlap = direct_overlap,
    cleaned_barcode_overlap = nrow(barcode_overlap),
    percent_tcr_barcodes_matched = nrow(barcode_overlap) / length(unique(tcr_barcodes)) * 100,
    percent_seurat_cells_with_tcr = nrow(barcode_overlap) / ncol(seurat_obj) * 100
  )
  
  write_csv(overlap_summary, file.path(outdir, "25_barcode_overlap_summary.csv"))
  
  tcr_cell_raw <- contig_prod %>%
    filter(chain %in% c("TRA", "TRB")) %>%
    left_join(
      clonos2 %>%
        select(clonotype_id, frequency, percent, frequency_bin),
      by = c("raw_clonotype_id" = "clonotype_id")
    ) %>%
    mutate(barcode_core = extract_10x_barcode(barcode))
  
  tcr_cell_meta <- tcr_cell_raw %>%
    group_by(barcode_core) %>%
    arrange(desc(percent), .by_group = TRUE) %>%
    summarise(
      tcr_clonotype_id = first(raw_clonotype_id),
      all_tcr_clonotype_ids = paste(sort(unique(raw_clonotype_id)), collapse = "; "),
      tcr_frequency = first(frequency),
      tcr_percent = first(percent),
      tcr_frequency_bin = first(frequency_bin),
      chains_detected = paste(sort(unique(chain)), collapse = "; "),
      tra_cdr3 = paste(sort(unique(na.omit(cdr3[chain == "TRA"]))), collapse = "; "),
      trb_cdr3 = paste(sort(unique(na.omit(cdr3[chain == "TRB"]))), collapse = "; "),
      tra_v_gene = paste(sort(unique(na.omit(v_gene[chain == "TRA"]))), collapse = "; "),
      trb_v_gene = paste(sort(unique(na.omit(v_gene[chain == "TRB"]))), collapse = "; "),
      tra_j_gene = paste(sort(unique(na.omit(j_gene[chain == "TRA"]))), collapse = "; "),
      trb_j_gene = paste(sort(unique(na.omit(j_gene[chain == "TRB"]))), collapse = "; "),
      .groups = "drop"
    )
  
  write_csv(tcr_cell_meta, file.path(outdir, "26_tcr_cell_level_metadata_for_seurat.csv"))
  
  seurat_key <- tibble(
    seurat_cell = colnames(seurat_obj),
    barcode_core = extract_10x_barcode(colnames(seurat_obj))
  )
  
  tcr_meta_for_seurat <- seurat_key %>%
    left_join(tcr_cell_meta, by = "barcode_core") %>%
    select(-barcode_core)
  
  tcr_meta_for_seurat <- as.data.frame(tcr_meta_for_seurat)
  rownames(tcr_meta_for_seurat) <- tcr_meta_for_seurat$seurat_cell
  tcr_meta_for_seurat$seurat_cell <- NULL
  tcr_meta_for_seurat <- tcr_meta_for_seurat[colnames(seurat_obj), , drop = FALSE]
  
  if (!identical(rownames(tcr_meta_for_seurat), colnames(seurat_obj))) {
    stop("TCR metadata rownames do not match Seurat cell names for ", set_id)
  }
  
  seurat_obj <- AddMetaData(
    object = seurat_obj,
    metadata = tcr_meta_for_seurat
  )
  
  # Visualize TCR expansion on the UMAP and across clusters
  
  p_tcr_umap <- DimPlot(
    seurat_obj,
    reduction = "umap",
    group.by = "tcr_frequency_bin",
    pt.size = 0.3
  ) +
    ggtitle(paste0(tcr_sample, " TCR Clonotype Expansion on ", gex_sample, " UMAP"))
  
  save_plot(p_tcr_umap, file.path(outdir, "27_UMAP_TCR_frequency_bin.png"), 8, 6)
  
  tcr_by_cluster <- seurat_obj@meta.data %>%
    rownames_to_column("cell") %>%
    filter(!is.na(tcr_frequency_bin)) %>%
    count(seurat_clusters, tcr_frequency_bin) %>%
    group_by(seurat_clusters) %>%
    mutate(percent = n / sum(n) * 100) %>%
    ungroup() %>%
    mutate(
      set_id = set_id,
      gex_sample = gex_sample,
      tcr_sample = tcr_sample
    )
  
  write_csv(tcr_by_cluster, file.path(outdir, "28_TCR_frequency_bin_by_Seurat_cluster.csv"))
  
  p_tcr_cluster <- tcr_by_cluster %>%
    ggplot(aes(x = seurat_clusters, y = percent, fill = tcr_frequency_bin)) +
    geom_col() +
    labs(
      title = paste0(tcr_sample, " TCR Expansion Categories by ", gex_sample, " Cluster"),
      x = "Seurat cluster",
      y = "Percent of TCR-positive cells",
      fill = "TCR category"
    ) +
    theme_classic()
  
  save_plot(p_tcr_cluster, file.path(outdir, "28_TCR_frequency_bin_by_cluster.png"), 9, 6)
  
  top_clones_by_cluster <- seurat_obj@meta.data %>%
    rownames_to_column("cell") %>%
    filter(!is.na(tcr_clonotype_id)) %>%
    count(seurat_clusters, tcr_clonotype_id, tcr_frequency_bin, sort = TRUE) %>%
    mutate(
      set_id = set_id,
      gex_sample = gex_sample,
      tcr_sample = tcr_sample
    )
  
  write_csv(top_clones_by_cluster, file.path(outdir, "29_Top_TCR_clonotypes_by_cluster.csv"))
  
  # Add the preliminary cell-type annotations
  
  celltype_vec <- unname(cluster_label_vector[as.character(seurat_obj$seurat_clusters)])
  
  if (length(celltype_vec) != ncol(seurat_obj)) {
    stop("Cell type label vector length does not match Seurat cells for ", set_id)
  }
  
  seurat_obj$celltype_firstpass <- celltype_vec
  
  p_celltypes <- DimPlot(
    seurat_obj,
    reduction = "umap",
    group.by = "celltype_firstpass",
    label = TRUE,
    repel = TRUE
  ) +
    ggtitle(paste0(set_id, " First-pass Cell Type Annotation"))
  
  save_plot(p_celltypes, file.path(outdir, "30_UMAP_firstpass_celltype_annotation.png"), 10, 7)
  
  # Summarize TCR expansion by annotated cell type
  
  tcr_by_celltype <- seurat_obj@meta.data %>%
    rownames_to_column("cell") %>%
    filter(!is.na(tcr_frequency_bin), !is.na(celltype_firstpass)) %>%
    count(celltype_firstpass, tcr_frequency_bin) %>%
    group_by(celltype_firstpass) %>%
    mutate(percent = n / sum(n) * 100) %>%
    ungroup() %>%
    mutate(
      set_id = set_id,
      gex_sample = gex_sample,
      tcr_sample = tcr_sample
    )
  
  write_csv(tcr_by_celltype, file.path(outdir, "31_TCR_frequency_bin_by_celltype_firstpass.csv"))
  
  p_tcr_celltype <- tcr_by_celltype %>%
    ggplot(aes(x = celltype_firstpass, y = percent, fill = tcr_frequency_bin)) +
    geom_col() +
    coord_flip() +
    labs(
      title = paste0(set_id, " TCR Expansion Categories by Cell Type"),
      x = "First-pass cell type",
      y = "Percent of TCR-positive cells",
      fill = "TCR category"
    ) +
    theme_classic()
  
  save_plot(p_tcr_celltype, file.path(outdir, "31_TCR_frequency_bin_by_celltype_firstpass.png"), 10, 7)
  
  top_clones_by_celltype <- seurat_obj@meta.data %>%
    rownames_to_column("cell") %>%
    filter(!is.na(tcr_clonotype_id), !is.na(celltype_firstpass)) %>%
    count(celltype_firstpass, tcr_clonotype_id, tcr_frequency_bin, sort = TRUE) %>%
    mutate(
      set_id = set_id,
      gex_sample = gex_sample,
      tcr_sample = tcr_sample
    )
  
  write_csv(top_clones_by_celltype, file.path(outdir, "32_Top_TCR_clonotypes_by_celltype.csv"))
  
  # Save the annotated Seurat object
  
  final_rds <- file.path(
    outdir,
    paste0(set_id, "_", tcr_sample, "_TCR_with_", gex_sample, "_GEX_FINAL.rds")
  )
  
  saveRDS(seurat_obj, final_rds)
  
  message("Finished ", set_id, ". Output folder: ", outdir)
  
  # Keep only the summary tables needed for the cross-sample analysis
  result <- list(
    set_id = set_id,
    gex_sample = gex_sample,
    tcr_sample = tcr_sample,
    outdir = outdir,
    diversity_summary = diversity_summary,
    bin_summary = bin_summary,
    overlap_summary = overlap_summary,
    tcr_by_cluster = tcr_by_cluster,
    tcr_by_celltype = tcr_by_celltype,
    top_clones_by_celltype = top_clones_by_celltype,
    top_markers_compact = top_markers_compact
  )
  
  rm(seurat_obj, gex_counts)
  gc()
  
  return(result)
}

